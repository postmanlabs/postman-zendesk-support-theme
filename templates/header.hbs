      }
      .drawer {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 60;
        display: block;
        overflow: hidden;
        background: var(--pm-nav-bg, #fff);
        max-height: 100vh;
        opacity: 1;
        /* visibility, not [hidden]/inert, is what keeps the closed drawer out of
           the tab order and the a11y tree: the same node holds the desktop
           menubar, so anything driven off _mobileOpen alone would hide the
           menubar for every desktop visitor too. Delay it on close so the
           collapse is visible, drop the delay on open. */
        visibility: visible;
        pointer-events: auto;
        transition:
          max-height 0.3s ease-in-out,
          opacity 0.3s ease-in-out,
          visibility 0s linear 0s;
      }
      .drawer[data-open='false'] {
        max-height: 0;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
          max-height 0.3s ease-in-out,
          opacity 0.3s ease-in-out,
          visibility 0s linear 0.3s;
      }
      .drawer:focus-visible {
        outline: none;
      }
      .drawer-scroll {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        box-sizing: border-box;
        height: calc(100vh - 54px);
        overflow-y: auto;
        padding-top: 16px;
      }
      .menubar {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        box-sizing: border-box;
        width: 100%;
        padding: 10px;
      }
      .item {
        margin: 0 8px 10px;
      }
      /* The 15px side padding is an xl-only rule in the source. */
      .trigger,
      .top-link {
        padding: 0;
      }
      .drawer-account {
        display: block;
        margin: 10px 0;
        padding: 3px 0 0 16px;
      }
      .drawer-local {
        display: block;
        margin: 10px 0;
        padding-left: 16px;
      }
      /* Accordion. A closed panel collapses instead of going display:none, so it
         can animate like the drawer; visibility keeps its links untabbable and
         unannounced while collapsed. */
      .panel {
        position: static;
        width: auto;
        max-width: none;
        margin-top: 8px;
        box-shadow: none;
        border: 0;
        border-radius: 0;
        padding: 10px;
        overflow: hidden;
        /* 300vh is the source's value. The floor is not: below ~560px of
           viewport height (any phone in landscape, still under the breakpoint)
           300vh is shorter than the stacked Product panel, and max-height
           CLIPS — the source silently loses its bottom rows there. */
        max-height: max(300vh, 2400px);
        opacity: 1;
        visibility: visible;
        transition:
          max-height 0.3s ease-in-out,
          padding 0.3s ease-in-out,
          margin-top 0.3s ease-in-out,
          opacity 0.3s ease-in-out,
          visibility 0s linear 0s;
      }
      .panel[hidden] {
        /* Beats the base rule's display:none (same specificity, both important —
           this one is later). Per-display-type so the Product panel does not
           flip block/flex mid-collapse. */
        display: block !important;
        max-height: 0;
        /* A border-box height can never go below its own padding, so max-height:0
           alone leaves every collapsed panel 20px tall — which is what spaced the
           dropdown rows 28px further apart than the plain links. The source gets
           this for free by putting the padding on a separate inner element. */
        padding-top: 0;
        padding-bottom: 0;
        margin-top: 0;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
          max-height 0.3s ease-in-out,
          padding 0.3s ease-in-out,
          margin-top 0.3s ease-in-out,
          opacity 0.3s ease-in-out,
          visibility 0s linear 0.3s;
      }
      /* Product only. Its .panel.has-brands rule below re-declares padding at the
         same specificity as .panel[hidden] and comes later, so the collapse has
         to be restated here to win. */
      .panel.has-brands[hidden] {
        display: flex !important;
        padding-top: 0;
        padding-bottom: 0;
        margin-top: 0;
      }
      .columns {
        flex-direction: column;
        gap: 0;
      }
      /* Product's Platform/Explore column leads on mobile with a rule UNDER it
         (the source's "border-b" / "xl:order-last xl:border-l"), so undo the
         desktop left divider and pull it back to the front. */
      .col.left-nav {
        order: -1;
        width: auto;
        margin-left: 0;
        border-left: 0;
        border-bottom: 1px solid #e6e6e6;
        padding-left: 20px;
        padding-bottom: 15px;
      }
      .col.w210 {
        width: auto;
        padding: 30px 0;
      }
      /* "Download Postman →" is a bottom-anchored CTA in the desktop Platform
         column (mt-auto); the source hides it outside that layout rather than
         leaving a stray blue link in the drawer. */
      .menu-item.app-cta {
        display: none;
      }
      .col.w180 {
        width: auto;
      }
      /* One column per row: two columns of 14px titles + descriptions do not fit
         a phone (the source drops to grid-cols-1 below lg for the same reason). */
      .solutions-grid {
        grid-template-columns: 1fr;
        width: auto;
      }
      .card-row {
        flex-direction: column;
        gap: 0;
      }
      /* The featured cards lose their grey/gradient fill on mobile (the source
         hides the gradient layer below xl). The gradient is an inline style, so
         only !important can take it back off. */
      .featured .menu-item,
      .featured .feat-card {
        background: none !important;
        box-shadow: none;
      }
      /* Stack the brands sidebar below the columns on small screens. */
      .panel.has-brands {
        flex-direction: column;
        background: none;
        padding: 10px;
      }
      .panel-inner {
        width: auto;
        background: none;
        box-shadow: none;
        border-radius: 0;
        padding: 0;
      }
      .brands-panel {
        width: auto;
        padding: 20px 0 0;
        margin-top: 10px;
        border-top: 1px solid #e6e6e6;
      }
    }

    /* Respect a reduced-motion preference: the drawer and its accordions still
       open and close, they just do it instantly. */
    @media (prefers-reduced-motion: reduce) {
      .drawer,
      .drawer[data-open='false'],
      .panel,
      .panel[hidden],
      .chevron,
      .trigger[aria-expanded='true'] .chevron,
      .ham-bar {
        transition: none;
      }
    }

    /* ---------------------------------------------------------------------
       DARK THEME (theme="dark") — the redesigned www.postman.com homepage's
       nav treatment, ported from GlobalNavbar.jsx/NavDropdownMenu.jsx's
       dark: variants. Scoping this to '/' and '/home/' is the CONSUMER's
       job (see the theme property doc above); this block only implements
       what the attribute looks like once set.

       Where a rule below already reads a --pm-nav-*/--pm-panel-*/--pm-brands-*
       custom property, redefining the property here is enough — every rule
       using it anywhere above re-resolves automatically. Rules with hardcoded
       colors (menu-item text, the account buttons, the hamburger bars, the
       featured-card icon filter) need an explicit override instead, since
       there is no shared token they can be redirected through without also
       affecting the light theme.
       --------------------------------------------------------------------- */
    :host([theme='dark']) {
      --pm-nav-bg: #0e0704;
      --pm-nav-border: #2a2018;
      --pm-nav-link: #8a8178;
      --pm-nav-link-hover: #fff;
      --pm-nav-fg: #cdbfad;
      --pm-nav-section: #ff8e64;
      --pm-nav-hover-bg: #241811;
      --pm-panel-bg: #17100a;
      --pm-panel-border: #2a2018;
      --pm-brands-bg: #221710;
      /* The featured cards' near-black icon tint (navIconDark) disappears
         against a dark panel; invert it light instead, same as the site. */
      --pm-nav-icon-filter-dark: brightness(0) invert(85%);
    }
    :host([theme='dark']) .menu-item .title,
    :host([theme='dark']) .menu-item .desc,
    :host([theme='dark']) .brand-item .title,
    :host([theme='dark']) .brand-item .desc {
      color: var(--pm-nav-fg, #cdbfad);
    }
    :host([theme='dark']) .menu-item.see-all .title {
      color: var(--pm-nav-section, #ff8e64);
    }
    :host([theme='dark']) .menu-item.app-cta .title {
      color: #5aa2ff;
    }
    :host([theme='dark']) .col-badge {
      background: #241811;
      border-color: #3a2c22;
      color: var(--pm-nav-fg, #cdbfad);
    }
    :host([theme='dark']) .col.left-nav {
      /* Desktop uses border-left; the mobile media query below swaps it for
         border-bottom (source: "border-b" / "xl:border-l") — override both
         sides so the drawer doesn't keep a light-theme #e6e6e6 divider. */
      border-left-color: #2a2018;
      border-bottom-color: #2a2018;
    }
    :host([theme='dark']) .featured {
      border-top-color: #2a2018;
    }
    :host([theme='dark']) .brands-panel {
      /* Only the mobile media query below gives .brands-panel a border-top;
         harmless no-op at desktop where it has none. */
      border-top-color: #2a2018;
    }
    :host([theme='dark']) .featured .menu-item {
      background: #1e1e1e;
    }
    /* Hamburger bars use the warm-grey fg token, not --pm-nav-link: the site
       keys these two off different shades (#cdbfad vs #8a8178). */
    :host([theme='dark']) .ham-bar {
      background: var(--pm-nav-fg, #cdbfad);
    }
    /* Account buttons: GenericButton's secondaryGhost variant — transparent,
       warm-grey border/text, inverts toward a warm white on hover. The filled
       light-grey default would read as a pale block on the near-black bar. */
    :host([theme='dark']) .acct-secondary {
      color: var(--pm-nav-fg, #cdbfad);
      border-color: var(--pm-nav-fg, #cdbfad);
    }
    :host([theme='dark']) .acct-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: #fff0de;
      color: #fff0de;
    }
    @media (max-width: 1149.98px) {
      :host([theme='dark']) .logo-mark {
        display: none;
      }
      :host([theme='dark']) .logo-wordmark {
        display: block;
      }
    }
